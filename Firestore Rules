rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isStaff() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin','manager'];
    }

    function isLoggedIn() {
      return request.auth != null;
    }
    
    match /products/{productId} {
      allow read: if true;
      allow write: if isStaff();
      allow update: if isLoggedIn() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']) &&
                       request.resource.data.stock is int &&
                       request.resource.data.stock >= 0 &&
                       request.resource.data.stock < resource.data.stock &&
                       (resource.data.stock - request.resource.data.stock) <= 50;
    }


    // =====================================================================
    // أكواد الخصم
    // coupons/{CODE}: تعريف الكود (يديره الأدمن). يعرف العميل الكود فيقرأه بـ get ولا يستطيع تصفّح القائمة.
    // coupon_uses/{orderId}: سجل استعمال لكل طلب، يُنشأ في نفس دفعة الطلب، وهنا تُفحص كل الشروط.
    // coupon_clients/{CODE__uid}: عدّاد استعمال العميل الواحد للكود.
    // ملاحظة: القواعد لا تستطيع إعادة حساب أسعار البنود، فهي تضبط: صلاحية الكود والوقت والجمهور
    // والحد الأدنى للشراء وسقف الخصم وعدد الاستعمال (للعميل ولإجمالي الكود).
    // =====================================================================
    match /coupons/{code} {
      allow get: if isLoggedIn();
      allow list: if isStaff();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        // موظف يُرجع استعمالاً عند إلغاء طلب عليه كود (ينقص العدّاد بواحد فقط)
        (isStaff() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount']) &&
         resource.data.get('usedCount', 0) > 0 &&
         request.resource.data.usedCount == resource.data.usedCount - 1) ||
        (isLoggedIn() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount','lastOrderId']) &&
         request.resource.data.usedCount == resource.data.get('usedCount', 0) + 1 &&
         (resource.data.maxTotal == 0 || request.resource.data.usedCount <= resource.data.maxTotal) &&
         existsAfter(/databases/$(database)/documents/coupon_uses/$(request.resource.data.lastOrderId)) &&
         getAfter(/databases/$(database)/documents/coupon_uses/$(request.resource.data.lastOrderId)).data.code == code);
    }

    match /coupon_clients/{cid} {
      allow get: if isStaff() ||
                    (isLoggedIn() && (resource == null || resource.data.uid == request.auth.uid));
      allow list: if isStaff();
      allow create: if isLoggedIn() &&
                       request.resource.data.keys().hasOnly(['code','uid','count']) &&
                       request.resource.data.uid == request.auth.uid &&
                       cid == request.resource.data.code + '__' + request.auth.uid &&
                       request.resource.data.count == 1;
      allow update: if isLoggedIn() &&
                       resource.data.uid == request.auth.uid &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count']) &&
                       request.resource.data.count == resource.data.count + 1;
      allow update: if isStaff() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count']) &&
                       resource.data.count > 0 &&
                       request.resource.data.count == resource.data.count - 1;
      allow delete: if isAdmin();
    }

    // عملاء كود "عملاء معنيون": مستند لكل عميل (لا تُخزَّن إيميلاتهم داخل الكود، ولا يستطيع العميل إلا قراءة مستنده هو)
    match /coupon_targets/{tid} {
      allow get: if isStaff() || (isLoggedIn() && tid.matches('.*__' + request.auth.uid));
      allow list: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    // كود "الطلب الأول": علامة على رقم الهاتف تمنع إعادة الاستفادة بحساب جديد برقم الهاتف نفسه
    match /coupon_phones/{pid} {
      allow get: if isLoggedIn();
      allow list: if isStaff();
      allow create: if isLoggedIn() &&
                       request.resource.data.keys().hasOnly(['code','phone9','uid']) &&
                       request.resource.data.uid == request.auth.uid &&
                       request.resource.data.phone9 is string &&
                       request.resource.data.phone9.matches('^[0-9]{9}$') &&
                       pid == request.resource.data.code + '__' + request.resource.data.phone9;
      allow update: if false;
      allow delete: if isAdmin();
    }

    function couponUseValid(orderId) {
      let u = request.resource.data;
      let c = get(/databases/$(database)/documents/coupons/$(u.code)).data;
      let cc = getAfter(/databases/$(database)/documents/coupons/$(u.code)).data;
      let o = getAfter(/databases/$(database)/documents/orders/$(orderId)).data;
      let clientPath = /databases/$(database)/documents/coupon_clients/$(u.code + '__' + request.auth.uid);
      let targetPath = /databases/$(database)/documents/coupon_targets/$(u.code + '__' + request.auth.uid);
      let phonePath = /databases/$(database)/documents/coupon_phones/$(u.code + '__' + u.get('phone9', 'x'));
      // الخصم محسوب على المبلغ المؤهل (للمواد/الأقسام المحددة) أو على كل المبلغ
      let base = c.scope == 'all' ? o.originalTotal : o.couponEligibleTotal;
      let prev = exists(clientPath) ? get(clientPath).data.count : 0;
      let now = request.time.toMillis();
      return u.keys().hasOnly(['code','uid','email','orderId','discount','createdAt','phone9']) &&
        u.orderId == orderId &&
        u.uid == request.auth.uid &&
        u.email == request.auth.token.email &&
        u.discount is number && u.discount >= 0 &&
        existsAfter(/databases/$(database)/documents/orders/$(orderId)) &&
        o.couponCode == u.code &&
        o.clientUid == request.auth.uid &&
        o.couponDiscount == u.discount &&
        o.originalTotal is number &&
        c.active == true &&
        c.startsAtMs <= now &&
        (c.expiresAtMs == 0 || now <= c.expiresAtMs) &&
        (c.minPurchase == 0 || o.originalTotal >= c.minPurchase) &&
        (c.audience == 'all' || c.audience == 'new' || exists(targetPath)) &&
        (c.scope == 'all' || (o.couponEligibleTotal is number && o.couponEligibleTotal >= 0 && o.couponEligibleTotal <= o.originalTotal)) &&
        u.discount <= (c.type == 'percent' ? base * c.value / 100 : c.value) + 0.011 &&
        (c.maxDiscount == 0 || u.discount <= c.maxDiscount + 0.011) &&
        cc.usedCount == c.usedCount + 1 &&
        (c.maxTotal == 0 || cc.usedCount <= c.maxTotal) &&
        getAfter(clientPath).data.count == prev + 1 &&
        (c.audience != 'new' || (prev == 0 && u.phone9 is string && u.phone9.matches('^[0-9]{9}$') &&
          o.phone.replace('[^0-9]', '').matches('.*' + u.phone9) && !exists(phonePath) && existsAfter(phonePath))) &&
        (c.perClientMax == 0 || prev + 1 <= c.perClientMax);
    }

    match /coupon_uses/{orderId} {
      allow read: if isStaff();
      allow create: if isLoggedIn() && couponUseValid(orderId);
      allow update, delete: if false;
    }


    // =====================================================================
    // الذمم (البيع الآجل)
    // users/{uid}.creditEnabled / creditLimit: يحددهما الأدمن فقط.
    // credit_payments/{id}: دفعات السداد (يسجلها الموظف). رصيد العميل = مجموع فواتير الذمم − دفعاته، ويُحسب من البيانات.
    // القواعد تضمن أن طلب الذمم يخص عميلاً مفعّلاً له ولا يتجاوز حده؛ ومراجعة الرصيد التراكمي مسؤولية الأدمن عند تأكيد الطلب.
    // =====================================================================
    function creditOrderAllowed(total) {
      return isLoggedIn() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('creditEnabled', false) == true &&
             total <= get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('creditLimit', 0);
    }

    match /credit_payments/{pid} {
      allow read: if isStaff() || (isLoggedIn() && resource.data.clientUid == request.auth.uid);
      allow create: if isStaff() &&
                       request.resource.data.keys().hasOnly(['clientUid','clientEmail','clientName','orderId','amount','date','note','createdBy','createdAt']) &&
                       request.resource.data.amount is number &&
                       request.resource.data.amount > 0 &&
                       request.resource.data.amount < 10000000 &&
                       request.resource.data.orderId is string;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'id','clientName','clientEmail','clientUid','clinic','doctor','phone',
          'address','locationLat','locationLng','notes','items','total','totalPoints',
          'payMethod','pointsDeducted','status','createdAt','createdByAdmin','sourceQuoteId',
          'originalTotal','discountPercent','manualDiscountAmount','manualDiscountType','stockReserved',
          'deliveryFee','deliveryDetermined','altPhone','couponCode','couponDiscount','couponEligibleTotal'
        ]) &&
        // طلب عليه كود خصم: يجب أن يُنشأ معه في نفس الدفعة سجل استعمال الكود (coupon_uses) الذي يتحقق من شروط الكود وعدّاده
        (!('couponCode' in request.resource.data) || request.resource.data.couponCode == null ||
          (isLoggedIn() && existsAfter(/databases/$(database)/documents/coupon_uses/$(orderId)))) &&
        request.resource.data.keys().hasAll(['id','clinic','doctor','phone','items','total','status','createdAt']) &&
        request.resource.data.pointsDeducted == false &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.items.size() <= 100 &&
        request.resource.data.total is number &&
        request.resource.data.total >= 0 &&
        request.resource.data.phone is string &&
        (
          (
            isStaff() &&
            request.resource.data.status in ['pending','confirmed'] &&
            request.resource.data.payMethod in ['money','points','free','credit']
          )
          ||
          (
            request.resource.data.status == 'pending' &&
            // المبلغ النقدي أكبر من صفر؛ أما الدفع بالنقاط فقد يكون المبلغ النقدي صفراً (كل المواد مدفوعة بالنقاط والتوصيل مجاني/غير محدد)
            // بشرط وجود نقاط مطلوبة. النقاط لا تُخصم إلا عند تأكيد التسليم من الأدمن بعد التحقق من رصيد العميل.
            (request.resource.data.total > 0 ||
             (request.resource.data.payMethod == 'points' &&
              request.resource.data.totalPoints is number &&
              request.resource.data.totalPoints > 0)) &&
            request.resource.data.phone.size() > 5 &&
            (request.resource.data.payMethod == null ||
             request.resource.data.payMethod in ['money','points','credit']) &&
            // بيع آجل: فقط لعميل مسجّل فعّل له الأدمن الذمم، وقيمة الطلب لا تتجاوز حده الائتماني
            (request.resource.data.payMethod != 'credit' || creditOrderAllowed(request.resource.data.total)) &&
            (isLoggedIn()
              ? request.resource.data.clientEmail == request.auth.token.email
              : request.resource.data.clientEmail == 'guest') &&
            request.resource.data.clientUid == (isLoggedIn() ? request.auth.uid : null)
          )
        );

      // get: قراءة طلب واحد بمعرفه المحدد (تستخدمها ميزة تتبّع الطلب)
      allow get: if isStaff() ||
                     (isLoggedIn() && resource.data.clientEmail == request.auth.token.email) ||
                     resource.data.clientEmail == 'guest';

      // list: أي استعلام/تصفح لمجموعة طلبات — ممنوع لغير الموظفين
      // (يمنع سحب كل طلبات الزوار دفعة وحدة عبر where('clientEmail','==','guest'))
      allow list: if isStaff() ||
                      (isLoggedIn() && request.auth.token.email == resource.data.clientEmail);

      allow update: if (isStaff() &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status','stockDeducted','pointsDeducted','earnPointsAwarded','stockReleased','deliveryFee','deliveryDetermined','total','couponRefunded']))
                       ||
                       (isLoggedIn() &&
                        resource.data.clientEmail == request.auth.token.email &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['clientName','doctor','clinic','phone']))
                       ||
                       (isLoggedIn() &&
                        resource.data.clientEmail == 'guest' &&
                        resource.data.phone == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone &&
                        request.resource.data.clientEmail == request.auth.token.email &&
                        request.resource.data.clientUid == request.auth.uid &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['clientName','doctor','clinic','phone','clientEmail','clientUid']));

      allow delete: if isAdmin();
    }

    match /points/{userId} {
      allow read: if isAdmin() ||
                      (isLoggedIn() && request.auth.uid == userId);
      allow write: if isAdmin() &&
                      request.resource.data.keys().hasOnly(['email','uid','balance','logs']) &&
                      request.resource.data.balance is number &&
                      request.resource.data.balance >= 0 &&
                      request.resource.data.logs is list;
    }
match /delivery_settings/{userId} {
      allow read: if userId == '_global' || isStaff() ||
                      (isLoggedIn() && request.auth.uid == userId);
      allow write: if isStaff();
    }
    match /store_data/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /users/{userId} {
      allow read: if isStaff() ||
                      (isLoggedIn() && request.auth.uid == userId);

      allow create: if isLoggedIn() &&
                       request.auth.uid == userId &&
                       request.resource.data.role == 'client' &&
                       !request.resource.data.keys().hasAny(['creditEnabled','creditLimit','creditBalance']);

      allow update: if isAdmin() ||
                       (isLoggedIn() && request.auth.uid == userId &&
                        // الدور لا يتغير لأنه خارج قائمة الحقول المسموح تعديلها أدناه (affectedKeys)؛ فحص تساويه صراحةً كان يرفض الحساب
                        // إذا لم يحمل مستنده حقل role، وهو فحص زائد.
                        request.resource.data.email.lower() == request.auth.token.email.lower() &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['firstName','clinic','phone','email','profileLocationText','profileLocationLat','profileLocationLng','altPhone','updatedAt']));

      allow delete: if isAdmin() ||
                       (isLoggedIn() && request.auth.uid == userId);
    }

    match /contact_messages/{msgId} {
      allow create: if
        request.resource.data.keys().hasOnly(['name','email','message','createdAt']) &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 100 &&
        request.resource.data.email is string && request.resource.data.email.size() > 0 && request.resource.data.email.size() < 150 &&
        request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() < 2000;
      allow read: if isStaff();
      allow update, delete: if false;
    }

    match /quotes/{quoteId} {
      allow get: if isStaff() ||
                  (isLoggedIn() && resource.data.clientEmail == request.auth.token.email) ||
                  resource.data.clientEmail == 'guest';

      allow list: if isStaff() ||
                  (isLoggedIn() && request.auth.token.email == resource.data.clientEmail);

      allow create: if
        request.resource.data.keys().hasOnly([
          'id','clientName','clientEmail','clientUid','clinic','phone',
          'items','notes','attachedImage','status','createdAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'id','clientName','clientEmail','clinic','phone','items','notes','attachedImage','status','createdAt'
        ]) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.items.size() <= 50 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() > 5 &&
        request.resource.data.phone.size() < 30 &&
        request.resource.data.clientName is string &&
        request.resource.data.clientName.size() > 0 &&
        request.resource.data.clientName.size() < 100 &&
        request.resource.data.clinic is string &&
        request.resource.data.clinic.size() < 150 &&
        request.resource.data.notes is string &&
        request.resource.data.notes.size() < 2000 &&
        (request.resource.data.attachedImage == null ||
         (request.resource.data.attachedImage is string &&
          request.resource.data.attachedImage.size() < 500 &&
          request.resource.data.attachedImage.matches('^https://res\\.cloudinary\\.com/.*'))) &&
        (isLoggedIn()
          ? request.resource.data.clientEmail == request.auth.token.email
          : request.resource.data.clientEmail == 'guest') &&
        request.resource.data.clientUid == (isLoggedIn() ? request.auth.uid : null);

      allow update: if isStaff() ||
                    (isLoggedIn() &&
                     resource.data.clientEmail == request.auth.token.email &&
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'orderStatus']) &&
                     resource.data.status in ['priced', 'saved'] &&
                     request.resource.data.status in ['accepted', 'rejected', 'saved', 'priced']) ||
                    (isLoggedIn() &&
                     resource.data.clientEmail == request.auth.token.email &&
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clientName','phone'])) ||
                    (isLoggedIn() &&
                     resource.data.clientEmail == 'guest' &&
                     resource.data.phone == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone &&
                     request.resource.data.clientEmail == request.auth.token.email &&
                     request.resource.data.clientUid == request.auth.uid &&
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clientName','phone','clientEmail','clientUid']));

      allow delete: if isAdmin();
    }

    match /activity_log/{logId} {
      allow create: if isLoggedIn() &&
                       request.resource.data.keys().hasOnly(['email','name','type','details','createdAt']) &&
                       request.resource.data.email == request.auth.token.email &&
                       request.resource.data.type in ['login','add_to_cart','order_placed','register','profile_updated'] &&
                       request.resource.data.name is string && request.resource.data.name.size() < 100 &&
                       request.resource.data.details is map && request.resource.data.details.size() < 20;
      allow read: if isStaff();
      allow update, delete: if false;
    }

    match /fcm_tokens/{tokenId} {
      // لا قراءة من العميل؛ الإرسال يتم من Cloudflare Worker بحساب الخدمة
      allow read: if false;
      allow create, update: if isLoggedIn() &&
                            (tokenId == request.auth.uid || tokenId == request.auth.token.email) &&
                            request.resource.data.keys().hasOnly(['token','email','role','updatedAt']) &&
                            request.resource.data.token is string && request.resource.data.token.size() < 500 &&
                            request.resource.data.email == request.auth.token.email;
      allow delete: if isLoggedIn() &&
                    (tokenId == request.auth.uid || tokenId == request.auth.token.email);
    }

    match /notifications/{notifId} {
      allow read: if isStaff() ||
                  (isLoggedIn() &&
                   (resource.data.scope == 'broadcast' ||
                    resource.data.targetEmail == request.auth.token.email));

      allow create: if isStaff() ||
                    (request.resource.data.scope == 'admin' &&
                     request.resource.data.targetEmail == null &&
                     request.resource.data.keys().hasOnly(['scope','targetEmail','icon','title','message','link','createdAt']) &&
                     request.resource.data.icon is string && request.resource.data.icon.size() < 10 &&
                     request.resource.data.title is string && request.resource.data.title.size() < 100 &&
                     request.resource.data.message is string && request.resource.data.message.size() < 500 &&
                     (request.resource.data.link == null ||
                      (request.resource.data.link is string && request.resource.data.link.size() < 200)));

      allow update, delete: if isStaff();
    }

    match /messages/{messageId} {
      allow read: if isStaff() ||
                  (isLoggedIn() &&
                   (resource.data.clientEmail == request.auth.token.email ||
                    resource.data.clientEmail == 'broadcast'));

      allow create: if
        request.resource.data.keys().hasOnly(['clientEmail','fromRole','fromName','text','imageUrl','createdAt']) &&
        request.resource.data.text is string && request.resource.data.text.size() < 2000 &&
        request.resource.data.fromName is string && request.resource.data.fromName.size() < 100 &&
        (request.resource.data.imageUrl == null ||
         (request.resource.data.imageUrl is string &&
          request.resource.data.imageUrl.size() < 500 &&
          request.resource.data.imageUrl.matches('^https://res\\.cloudinary\\.com/.*'))) &&
        (
          (isStaff() && request.resource.data.fromRole == 'admin') ||
          (isLoggedIn() &&
           request.resource.data.fromRole == 'client' &&
           request.resource.data.clientEmail == request.auth.token.email)
        );

      allow update, delete: if false;
    }
  }
}